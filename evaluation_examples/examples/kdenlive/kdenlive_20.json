{
  "id": "kdenlive_20",
  "instruction": "Add a new video track named 'Outro Cue' and place the existing Intro Wide clip on it at frame 360 for 90 frames.",
  "source": "asil_benchmark_v1",
  "snapshot": "kdenlive_default_project",
  "config": [],
  "related_apps": ["kdenlive"],
  "evaluator": {
    "selection": "best_score",
    "paths": [
      {
        "path_id": "kdenlive_20_primary_path",
        "exclusive_group": "success_paths",
        "checkpoints": [
          {
            "id": "kdenlive_20_new_track",
            "weight": 0.4,
            "gui_visible_required": true,
            "rule": {
              "element_value": {
                "id": "track:video_outro_cue",
                "key": "name",
                "expected": "Outro Cue"
              }
            }
          },
          {
            "id": "kdenlive_20_clip_block",
            "weight": 0.6,
            "gui_visible_required": true,
            "rule": {
              "any_element_matches": {
                "type": "timeline_clip",
                "id": "timeline_clip:tl_outro_intro",
                "value": {
                  "track_id": "video_outro_cue",
                  "position": 360,
                  "duration": 90,
                  "clip_title": "Intro Wide"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low",
  "_asil": {
    "software": "kdenlive",
    "difficulty": "medium",
    "description": "Add a new video track named 'Outro Cue' and place the existing Intro Wide clip on it at frame 360 for 90 frames.",
    "actions": [
      {
        "action_type": "modify_file",
        "target": "{{project_path}}",
        "params": {
          "operations": [
            {
              "action": "add_element",
              "parent_xpath": "/kdenliveProject/timeline",
              "tag": "track",
              "attributes": {
                "id": "video_outro_cue",
                "kind": "video",
                "name": "Outro Cue",
                "muted": "0",
                "locked": "0"
              }
            },
            {
              "action": "add_element",
              "parent_xpath": "/kdenliveProject/timeline/track[@id='video_outro_cue']",
              "tag": "clipref",
              "attributes": {
                "id": "tl_outro_intro",
                "clip_id": "clip_intro",
                "start": "360",
                "duration": "90",
                "in": "0",
                "out": "90"
              }
            }
          ]
        }
      }
    ],
    "validation": {
      "all_of": [
        {
          "element_value": {
            "id": "track:video_outro_cue",
            "key": "name",
            "expected": "Outro Cue"
          }
        },
        {
          "any_element_matches": {
            "type": "timeline_clip",
            "id": "timeline_clip:tl_outro_intro",
            "value": {
              "track_id": "video_outro_cue",
              "position": 360,
              "duration": 90,
              "clip_title": "Intro Wide"
            }
          }
        }
      ]
    },
    "initial_state": "default"
  },
  "gui_expectations": {
    "success_surface": "timeline",
    "visible_change_summary": "A new video track labeled 'Outro Cue' appears with an Intro Wide block beginning at frame 360.",
    "checkpoint_visibility": {
      "kdenlive_20_new_track": "visible_in_track_header",
      "kdenlive_20_clip_block": "visible_in_timeline_clip_block"
    }
  }
}
