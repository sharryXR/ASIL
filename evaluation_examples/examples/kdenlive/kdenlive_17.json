    "difficulty": "medium",
    "description": "Add a new video track named 'Review Layer' and lock it.",
    "actions": [
      {
        "action_type": "modify_file",
        "target": "{{project_path}}",
        "params": {
          "operations": [
            {
              "action": "add_element",
