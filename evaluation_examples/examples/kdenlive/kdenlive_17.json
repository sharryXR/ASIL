        "checkpoints": [
          {
            "id": "kdenlive_17_new_track",
            "weight": 0.5,
            "gui_visible_required": true,
            "rule": {
              "element_value": {
                "id": "track:video_review",
                "key": "name",
                "expected": "Review Layer"
              }
            }
          },
          {
            "id": "kdenlive_17_track_locked",
            "weight": 0.5,
            "gui_visible_required": true,
            "rule": {
              "element_value": {
                "id": "track:video_review",
                "key": "locked",
                "expected": true
              }
            }
          }
        ]
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low",
  "_asil": {
