          "element_value": {
            "id": "track:video_review",
            "key": "name",
            "expected": "Review Layer"
          }
        },
        {
          "element_value": {
            "id": "track:video_review",
            "key": "locked",
            "expected": true
          }
        }
      ]
    },
    "initial_state": "default"
  },
  "gui_expectations": {
    "success_surface": "timeline",
    "visible_change_summary": "A new locked video track labeled 'Review Layer' appears in the track stack.",
    "checkpoint_visibility": {
      "kdenlive_17_new_track": "visible_in_track_header",
      "kdenlive_17_track_locked": "visible_in_track_header"
