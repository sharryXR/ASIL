{
  "id": "audacity_18",
  "instruction": "Remove Music Bed and add a new track named Ending Cue.",
  "source": "asil_benchmark_v1",
  "snapshot": "audacity_default_project",
  "config": [],
  "related_apps": [
    "audacity"
  ],
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low",
  "evaluator": {
    "selection": "best_score",
    "paths": [
      {
        "path_id": "audacity_18_main",
        "exclusive_group": "success",
        "checkpoints": [
          {
            "id": "music_removed",
            "weight": 0.5,
            "gui_visible_required": true,
            "rule": {
              "no_element_matches": {
                "type": "track",
                "id": "track:track_music"
              }
            }
          },
          {
            "id": "ending_added",
            "weight": 0.5,
            "gui_visible_required": true,
            "rule": {
              "any_element_matches": {
                "type": "track",
                "id": "track:track_ending_cue",
                "value": {
                  "name": "Ending Cue"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "_asil": {
    "software": "audacity",
    "difficulty": "simple",
    "description": "Remove Music Bed and add a new track named Ending Cue.",
    "actions": [
      {
        "action_type": "modify_file",
        "target": "{{project_path}}",
        "params": {
          "operations": [
            {
              "action": "delete_track",
              "track_id": "track_music"
            },
            {
              "action": "add_track",
              "track_id": "track_ending_cue",
              "name": "Ending Cue",
              "kind": "audio",
              "mute": false,
              "solo": false,
              "gain_db": 0.0,
              "pan": 0.0,
              "height_px": 132,
              "clips": []
            }
          ]
        }
      }
    ],
    "validation": {
      "any_element_matches": {
        "type": "track",
        "id": "track:track_ending_cue",
        "value": {
          "name": "Ending Cue"
        }
      }
    },
    "initial_state": "default"
  },
  "gui_expectations": {
    "success_surface": "multitrack_timeline",
    "visible_change_summary": "Music Bed disappears and an Ending Cue track appears.",
    "checkpoint_visibility": {
      "music_removed": "visible_in_track_headers",
      "ending_added": "visible_in_track_headers"
    }
  }
}
