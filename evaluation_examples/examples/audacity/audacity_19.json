            "weight": 0.33,
            "gui_visible_required": true,
            "rule": {
              "any_element_matches": {
                "type": "track",
                "id": "track:track_ambience",
                "value": {
                  "name": "Ambience"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "_asil": {
    "software": "audacity",
    "difficulty": "simple",
    "description": "Rename Voiceover to Main Narration, remove Music Bed, and add a new track named Ambience.",
    "actions": [
