{
  "id": "jupyterlab_18",
  "software": "jupyterlab",
  "difficulty": "medium",
  "description": "Retitle the summary markdown for publishing.",
  "instruction": "Open notebooks/summary.md and replace \"# Summary\" with \"# Publish Summary\".",
  "actions": [
    {
      "action_type": "modify_file",
      "target": "workspace",
      "params": {
        "operations": [
          {"action": "open_file", "path": "notebooks/summary.md"},
          {"action": "replace_text", "path": "notebooks/summary.md", "old": "# Summary", "new": "# Publish Summary"}
        ]
      }
    }
  ],
  "validation": {},
  "related_apps": ["jupyterlab"],
  "snapshot": "jupyterlab_default",
  "initial_state": "summary_focus",
  "gui_expectations": {
    "success_surface": "editor",
    "visible_change_summary": "The summary markdown title now reads Publish Summary.",
    "checkpoint_visibility": {
      "publish_title": "visible_in_editor"
    }
  },
  "evaluator": {
    "selection": "best_score",
    "paths": [
      {
        "path_id": "main",
        "exclusive_group": "success",
        "checkpoints": [
          {
            "id": "publish_title",
            "weight": 1.0,
            "gui_visible_required": true,
            "rule": {
              "element_contains": {
                "id": "editor:notebooks/summary.md",
                "key": "content",
                "expected": "# Publish Summary"
              }
            }
          }
        ]
      }
    ]
  },
  "_asil": {
    "software": "jupyterlab",
    "difficulty": "medium",
    "description": "Retitle the summary markdown for publishing.",
    "actions": [
      {
        "action_type": "modify_file",
        "target": "workspace",
        "params": {
          "operations": [
            {"action": "open_file", "path": "notebooks/summary.md"},
            {"action": "replace_text", "path": "notebooks/summary.md", "old": "# Summary", "new": "# Publish Summary"}
          ]
        }
      }
    ],
    "validation": {},
    "initial_state": "summary_focus"
  }
}
