{
  "id": "jupyterlab_02",
  "software": "jupyterlab",
  "difficulty": "simple",
  "description": "Retitle the notebook intro markdown.",
  "instruction": "Open notebooks/analysis.ipynb and change the first cell so it says \"# Weekly Analysis\\nFocus on April KPIs.\".",
  "actions": [
    {
      "action_type": "modify_file",
      "target": "workspace",
      "params": {
        "operations": [
          {"action": "open_file", "path": "notebooks/analysis.ipynb"},
          {"action": "set_cell_source", "path": "notebooks/analysis.ipynb", "cell_index": 0, "source": "# Weekly Analysis\nFocus on April KPIs."}
        ]
      }
    }
  ],
  "validation": {},
  "related_apps": ["jupyterlab"],
  "snapshot": "jupyterlab_default",
  "initial_state": "notebook_focus",
  "gui_expectations": {
    "success_surface": "notebook",
    "visible_change_summary": "The top markdown cell in the notebook calls out April KPIs.",
    "checkpoint_visibility": {
      "intro": "visible_in_notebook_cell"
    }
  },
  "evaluator": {
    "selection": "best_score",
    "paths": [
      {
        "path_id": "main",
        "exclusive_group": "success",
        "checkpoints": [
          {
            "id": "intro",
            "weight": 1.0,
            "gui_visible_required": true,
            "rule": {
              "element_contains": {
                "id": "cell:notebooks/analysis.ipynb:0",
                "key": "source",
                "expected": "April KPIs"
              }
            }
          }
        ]
      }
    ]
  },
