{
  "id": "multi_apps_029",
  "software": "multi_apps",
  "source": "asil_multi_apps_generated",
  "snapshot": "multi_apps_default",
  "instruction": "Coordinate the involved applications: rename meeting-notes.md to meeting-notes-multi_029.md; open a Gitea issue titled 'MA-029 release coordination'.",
  "related_apps": [
    "nautilus",
    "gitea"
  ],
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low",
  "config": [],
  "evaluator": {
    "paths": [
      {
        "path_id": "all_apps_completed",
        "exclusive_group": "default",
        "checkpoints": [
