          },
          {
            "id": "gitea_checkpoint",
            "weight": 0.5,
            "gui_visible_required": true,
            "rule": {
              "app_rule": {
                "app": "gitea",
                "rule": {
                  "any_element_contains": {
                    "type": "issue",
                    "key": "title",
                    "expected": "MA-029 release coordination"
                  }
                }
              }
            }
          }
        ]
      }
    ],
    "selection": "best_score"
  },
  "gui_expectations": {
    "success_surface": "multi_window",
    "visible_change_summary": "Each participating app shows its own visible artifact or state change for the shared task token.",
    "checkpoint_visibility": {
      "nautilus_checkpoint": "visible_in_nautilus",
      "gitea_checkpoint": "visible_in_gitea"
    }
  },
  "_asil": {
    "software": "multi_apps",
    "difficulty": "medium",
    "description": "File Workspace cross-app task for nautilus, gitea.",
    "initial_state": "default",
    "app_initial_states": {
      "nautilus": "default",
      "gitea": "default"
    },
    "primary_app": "nautilus",
    "actions": [
      {
        "action_type": "batch",
        "target": "multi_apps",
        "params": {
          "actions": [
            {
              "app": "nautilus",
