                "action_type": "api_call",
                "target": "gitea-api",
                "params": {
                  "method": "POST",
                  "endpoint": "/api/v1/repos/{{owner}}/{{repo}}/issues",
                  "body": {
                    "title": "MA-078 release coordination",
                    "body": "Track cross-app completion for MA-078."
                  }
                }
              }
            }
          ]
        }
      }
    ],
