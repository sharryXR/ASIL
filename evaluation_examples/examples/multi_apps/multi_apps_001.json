{
  "id": "multi_apps_001",
  "software": "multi_apps",
  "source": "asil_multi_apps_generated",
  "snapshot": "multi_apps_default",
  "instruction": "Coordinate the involved applications: create reports/multi_001_handoff.md with the handoff note; save reports/multi_001_analysis.md with the analysis note. Use these exact checkpoint text values where applicable: code_server: 'MA-001 code handoff complete'; jupyterlab: 'MA-001 notebook analysis saved'.",
  "related_apps": [
    "code_server",
    "jupyterlab"
  ],
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low",
  "config": [],
  "evaluator": {
    "paths": [
      {
        "path_id": "all_apps_completed",
        "exclusive_group": "default",
        "checkpoints": [
          {
            "id": "code_server_checkpoint",
            "weight": 0.5,
            "gui_visible_required": true,
            "rule": {
              "app_rule": {
                "app": "code_server",
                "rule": {
                  "element_contains": {
                    "id": "file:reports/multi_001_handoff.md",
                    "key": "content",
                    "expected": "MA-001 code handoff complete"
                  }
                }
              }
            }
          },
          {
            "id": "jupyterlab_checkpoint",
            "weight": 0.5,
            "gui_visible_required": true,
            "rule": {
              "app_rule": {
                "app": "jupyterlab",
                "rule": {
                  "element_contains": {
                    "id": "file:reports/multi_001_analysis.md",
                    "key": "content",
                    "expected": "MA-001 notebook analysis saved"
                  }
                }
              }
            }
          }
        ]
      }
    ],
    "selection": "best_score"
  },
  "gui_expectations": {
    "success_surface": "multi_window",
    "visible_change_summary": "Each participating app shows its own visible artifact or state change for the shared task token.",
    "checkpoint_visibility": {
      "code_server_checkpoint": "visible_in_code_server",
      "jupyterlab_checkpoint": "visible_in_jupyterlab"
    }
  },
  "_asil": {
    "software": "multi_apps",
    "difficulty": "medium",
    "description": "Dev Data cross-app task for code_server, jupyterlab.",
    "initial_state": "default",
    "app_initial_states": {
      "code_server": "default",
      "jupyterlab": "readme_focus"
    },
    "primary_app": "code_server",
    "actions": [
      {
        "action_type": "batch",
        "target": "multi_apps",
        "params": {
          "actions": [
            {
              "app": "code_server",
              "action": {
                "action_type": "modify_file",
                "target": "workspace",
                "params": {
                  "operations": [
                    {
                      "action": "create_file",
                      "path": "reports/multi_001_handoff.md",
                      "content": "MA-001 code handoff complete\n"
                    }
                  ]
                }
              }
            },
            {
              "app": "jupyterlab",
              "action": {
                "action_type": "modify_file",
                "target": "workspace",
                "params": {
                  "operations": [
                    {
                      "action": "create_file",
                      "path": "reports/multi_001_analysis.md",
                      "content": "MA-001 notebook analysis saved\n"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    ],
    "validation": {},
    "category": "dev_data"
  }
}
