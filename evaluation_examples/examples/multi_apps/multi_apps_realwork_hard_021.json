    "actions": [
      {
        "action_type": "batch",
        "target": "multi_apps",
        "params": {
          "actions": [
            {
              "app": "blender",
              "action": {
                "action_type": "invoke_function",
                "target": "blender",
                "params": {
                  "script": [
                    "import bpy",
                    "bpy.ops.mesh.primitive_uv_sphere_add(radius=1, location=(0, 0, 0))",
                    "mat = bpy.data.materials.new(name='MultiMat079')",
                    "bpy.context.object.data.materials.append(mat)"
                  ]
                }
              }
            }
          ]
        }
      },
      {
