            "x": 300,
            "y": 210,
            "width": 150,
            "height": 80,
            "fill": "#ede9fe",
            "stroke": "#7c3aed"
          },
          {
            "action": "add_shape",
            "id": "support",
            "label": "Support",
            "shape_kind": "rectangle",
            "x": 560,
            "y": 210,
            "width": 150,
            "height": 80,
            "fill": "#dcfce7",
            "stroke": "#16a34a"
          },
          {
            "action": "add_connector",
            "id": "handoff_1",
            "source": "intake",
            "target": "triage",
            "label": "route"
          },
          {
            "action": "add_connector",
            "id": "handoff_2",
            "source": "triage",
            "target": "support",
            "label": "assign"
          }
        ]
      }
    }
  ],
