{
  "id": "drawio_11",
  "software": "drawio",
  "difficulty": "medium",
  "description": "Create a support handoff flow on a blank canvas.",
  "instruction": "On a blank canvas, add Intake, Triage, and Support shapes with connectors Intake->Triage and Triage->Support.",
  "actions": [
    {
      "action_type": "modify_file",
      "target": "diagram",
