{
  "id": "drawio_14",
  "software": "drawio",
  "difficulty": "complex",
  "description": "Create a decision branch.",
  "instruction": "Add Approve and Reject rectangles to the default diagram, connect Review to Approve with approved and Review to Reject with rejected.",
  "actions": [
    {
      "action_type": "modify_file",
      "target": "diagram",
      "params": {
        "operations": [
          {
            "action": "add_shape",
            "id": "approve",
            "label": "Approve",
            "shape_kind": "rectangle",
            "x": 540,
            "y": 80,
            "width": 150,
            "height": 80,
            "fill": "#dcfce7",
            "stroke": "#16a34a"
          },
          {
            "action": "add_shape",
            "id": "reject",
            "label": "Reject",
            "shape_kind": "rectangle",
            "x": 540,
            "y": 240,
            "width": 150,
            "height": 80,
            "fill": "#fee2e2",
            "stroke": "#dc2626"
          },
          {
            "action": "add_connector",
            "id": "flow_approve",
            "source": "review",
            "target": "approve",
            "label": "approved",
            "stroke": "#16a34a"
          },
          {
            "action": "add_connector",
            "id": "flow_reject",
            "source": "review",
            "target": "reject",
            "label": "rejected",
            "stroke": "#dc2626"
          }
        ]
      }
    }
  ],
