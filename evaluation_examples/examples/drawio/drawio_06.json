{
  "id": "drawio_06",
  "software": "drawio",
  "difficulty": "medium",
  "description": "Create a three-step approval flow.",
  "instruction": "On a blank canvas, add Start, Review, and Deploy shapes from left to right, with connectors Start->Review and Review->Deploy.",
  "actions": [
    {
      "action_type": "modify_file",
      "target": "diagram",
      "params": {
        "operations": [
          {
            "action": "add_shape",
            "id": "start",
            "label": "Start",
            "shape_kind": "ellipse",
            "x": 60,
            "y": 160,
            "width": 120,
            "height": 70,
            "fill": "#dbeafe",
            "stroke": "#2563eb"
          },
          {
            "action": "add_shape",
            "id": "review",
            "label": "Review",
            "shape_kind": "rectangle",
            "x": 280,
            "y": 150,
            "width": 150,
            "height": 80,
            "fill": "#fef3c7",
            "stroke": "#d97706"
          },
          {
            "action": "add_shape",
            "id": "deploy",
            "label": "Deploy",
            "shape_kind": "rectangle",
            "x": 520,
            "y": 150,
            "width": 150,
            "height": 80,
            "fill": "#d1fae5",
            "stroke": "#059669"
          },
          {
            "action": "add_connector",
            "id": "flow_1",
            "source": "start",
            "target": "review",
            "label": "submit"
          },
          {
            "action": "add_connector",
            "id": "flow_2",
            "source": "review",
            "target": "deploy",
            "label": "approved"
          }
        ]
      }
    }
  ],
