          },
          {
            "action": "set_paragraph_text",
            "index": 1,
            "text": "The launch checklist is nearly complete."
          },
          {
            "action": "add_heading",
            "text": "Next Steps",
            "level": 2
          }
        ]
      }
    }
  ],
  "validation": {},
  "related_apps": [
    "libreoffice_writer"
  ],
  "snapshot": "writer_default",
  "initial_state": "default",
  "gui_expectations": {
    "success_surface": "document_page",
    "visible_change_summary": "The title and first paragraph change, and a Next Steps heading is appended.",
    "checkpoint_visibility": {
      "title": "visible_on_page",
      "p1": "visible_on_page",
      "heading_added": "visible_on_page"
    }
  },
  "evaluator": {
    "selection": "best_score",
    "paths": [
      {
        "path_id": "main",
        "exclusive_group": "success",
        "checkpoints": [
