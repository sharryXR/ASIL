                "key": "text_content",
                "expected": "Weekly Update"
              }
            }
          },
          {
            "id": "paragraph_updated",
            "weight": 0.5,
            "gui_visible_required": true,
            "rule": {
              "element_value": {
                "id": "paragraph:1",
                "key": "text_content",
                "expected": "Engineering blockers resolved."
              }
            }
          }
        ]
      }
    ]
  }
