  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low",
  "_asil": {
    "software": "blender",
    "difficulty": "complex",
    "description": "Create a monkey head (Suzanne) with a green material and subdivision modifier",
    "actions": [
      {
        "action_type": "invoke_function",
        "target": "bpy",
        "params": {
          "script": [
            "import bpy",
            "bpy.ops.mesh.primitive_monkey_add(location=(0, 0, 0))",
            "bpy.ops.object.modifier_add(type='SUBSURF')",
            "mat = bpy.data.materials.new(name='GreenMaterial')",
            "mat.use_nodes = True",
            "bsdf = mat.node_tree.nodes['Principled BSDF']",
            "bsdf.inputs['Base Color'].default_value = (0.0, 1.0, 0.0, 1.0)",
            "bpy.context.object.data.materials.append(mat)"
          ]
        }
      }
    ],
    "validation": {
      "material_exists": "GreenMaterial"
    },
    "initial_state": "blank"
  },
  "gui_expectations": {
    "success_surface": "viewport_and_modifier_panel",
    "visible_change_summary": "Suzanne appears with a green material and a visible subdivision modifier.",
    "checkpoint_visibility": {
      "suzanne_exists": "visible_in_viewport",
      "suzanne_at_origin": "visible_in_viewport",
