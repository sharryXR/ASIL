  "_asil": {
    "software": "blender",
    "difficulty": "complex",
    "description": "Create two cubes with different materials and animate the first one",
    "actions": [
      {
        "action_type": "invoke_function",
        "target": "bpy",
        "params": {
          "script": [
            "import bpy",
            "bpy.ops.mesh.primitive_cube_add(location=(0, 0, 0))",
            "cube1 = bpy.context.object",
            "mat1 = bpy.data.materials.new(name='Mat_Red')",
            "mat1.use_nodes = True",
            "mat1.node_tree.nodes['Principled BSDF'].inputs['Base Color'].default_value = (1.0, 0.0, 0.0, 1.0)",
            "cube1.data.materials.append(mat1)",
            "bpy.context.object.keyframe_insert(data_path='location', frame=1)",
            "bpy.context.object.location = (3, 0, 0)",
            "bpy.context.object.keyframe_insert(data_path='location', frame=20)",
            "bpy.ops.mesh.primitive_cube_add(location=(5, 0, 0))",
            "cube2 = bpy.context.object",
            "mat2 = bpy.data.materials.new(name='Mat_Blue')",
            "mat2.use_nodes = True",
            "mat2.node_tree.nodes['Principled BSDF'].inputs['Base Color'].default_value = (0.0, 0.0, 1.0, 1.0)",
            "cube2.data.materials.append(mat2)",
            "bpy.context.scene.frame_set(20)"
          ]
        }
      }
    ],
    "validation": {
      "material_exists": "Mat_Red"
    },
    "initial_state": "blank"
  },
