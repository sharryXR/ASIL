  "_asil": {
    "software": "blender",
    "difficulty": "complex",
    "description": "Create a product visualization scene: object, 3-point lighting, camera, and EEVEE render at 4K",
    "actions": [
      {
        "action_type": "invoke_function",
        "target": "bpy",
        "params": {
          "script": [
            "import bpy",
            "bpy.ops.mesh.primitive_uv_sphere_add(location=(0, 0, 0))",
            "bpy.ops.object.light_add(type='AREA', location=(3, -3, 5))",
            "bpy.ops.object.light_add(type='AREA', location=(-3, -3, 5))",
            "bpy.ops.object.light_add(type='AREA', location=(0, 5, 3))",
            "bpy.ops.object.camera_add(location=(0, -6, 2))",
            "bpy.context.scene.render.engine = 'BLENDER_EEVEE'",
            "bpy.context.scene.render.resolution_x = 3840",
            "bpy.context.scene.render.resolution_y = 2160"
          ]
        }
      }
    ],
    "validation": {
      "render_setting": {
        "key": "resolution_x",
        "expected": 3840
      }
    },
    "initial_state": "blank"
  },
