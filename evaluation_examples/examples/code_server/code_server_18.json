  "difficulty": "complex",
  "description": "Move the backlog note into a sprint note and update it.",
  "instruction": "Rename notes/backlog.md to notes/sprint.md, open notes/sprint.md, and append \"- Review the sprint plan\".",
  "actions": [
    {
      "action_type": "modify_file",
      "target": "workspace",
      "params": {
        "operations": [
