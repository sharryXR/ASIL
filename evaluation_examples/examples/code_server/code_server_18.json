            "path": "notes/backlog.md",
            "new_path": "notes/sprint.md"
          },
          {
            "action": "open_file",
            "path": "notes/sprint.md"
          },
          {
            "action": "append_text",
            "path": "notes/sprint.md",
            "text": "- Review the sprint plan\n"
          }
        ]
      }
    }
  ],
