{
  "id": "code_server_13",
  "software": "code_server",
  "difficulty": "medium",
  "description": "Create a feature flags file and note it in README.",
  "instruction": "Create src/feature_flags.py with \"ENABLED = True\n\" and append \"- Review feature flags\" to README.md.",
  "actions": [
    {
      "action_type": "modify_file",
      "target": "workspace",
      "params": {
        "operations": [
          {
            "action": "create_file",
            "path": "src/feature_flags.py",
            "content": "ENABLED = True\n"
          },
          {
            "action": "append_text",
            "path": "README.md",
            "text": "- Review feature flags\n"
          }
        ]
      }
    }
  ],
  "validation": {},
