{
  "id": "gimp_realwork_hard_004",
  "software": "gimp",
  "difficulty": "complex",
  "description": "Create a conservation campaign image from a real coastal photo.",
  "instruction": "Create an 800x600 conservation campaign image from the coast photo. Use a centered crop, lower brightness a little, increase saturation, add a deep green top banner, add the title PROTECT THE SHORE, and add the detail VOLUNTEER CLEANUP.",
  "source": "asil_realwork_hard_v1",
  "snapshot": "gimp_default",
  "config": [],
  "related_apps": [
    "gimp"
  ],
  "actions": [
    {
      "action_type": "invoke_function",
      "target": "gimp",
      "params": {
        "operations": [
          {
            "action": "add_image_layer",
            "id": "conservation_photo",
            "label": "Conservation Photo",
            "asset_path": "evaluation_examples/assets/realwork_images/coast_960.jpg",
            "x": 0,
            "y": 0,
            "width": 800,
            "height": 600,
            "crop": {
              "x": 70,
              "y": 10,
              "width": 820,
              "height": 615
            },
            "filters": {
              "brightness": 0.92,
              "contrast": 1.12,
              "saturation": 1.18
            }
          },
          {
            "action": "add_layer",
            "id": "campaign_banner",
            "label": "Campaign Banner",
            "kind": "rectangle",
            "x": 0,
            "y": 0,
            "width": 800,
            "height": 150,
            "fill": "#1b4332",
            "opacity": 0.84
          },
          {
            "action": "add_text_layer",
            "id": "campaign_title",
            "label": "Campaign Title",
            "text": "PROTECT THE SHORE",
            "x": 42,
            "y": 34,
            "font_size": 42,
            "color": "#ffffff"
          },
          {
            "action": "add_text_layer",
            "id": "campaign_detail",
            "label": "Campaign Detail",
            "text": "VOLUNTEER CLEANUP",
            "x": 46,
            "y": 96,
            "font_size": 24,
            "color": "#b7e4c7"
          }
        ]
      }
    }
  ],
