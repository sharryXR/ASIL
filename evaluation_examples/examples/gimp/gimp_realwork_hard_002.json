{
  "id": "gimp_realwork_hard_002",
  "software": "gimp",
  "difficulty": "complex",
  "description": "Create a real-photo travel postcard hero for a coastal retreat.",
  "instruction": "Create an 800x600 travel postcard from the real coast photo. Use a wide crop, slightly brighten and sharpen the image, add a translucent white title card near the lower left, add the title COASTAL RETREAT, and add the detail MAY WEEKEND GUIDE.",
  "source": "asil_realwork_hard_v1",
  "snapshot": "gimp_default",
  "config": [],
  "related_apps": [
    "gimp"
  ],
  "actions": [
    {
      "action_type": "invoke_function",
      "target": "gimp",
      "params": {
        "operations": [
          {
            "action": "add_image_layer",
            "id": "coast_photo",
            "label": "Coast Photo",
            "asset_path": "evaluation_examples/assets/realwork_images/coast_960.jpg",
            "x": 0,
            "y": 0,
            "width": 800,
            "height": 600,
            "crop": {
              "x": 0,
              "y": 0,
              "width": 960,
              "height": 720
            },
            "filters": {
              "brightness": 1.08,
              "contrast": 1.08,
              "saturation": 1.05,
              "sharpen": true
            }
          },
          {
            "action": "add_layer",
            "id": "title_card",
            "label": "Title Card",
            "kind": "rectangle",
            "x": 36,
            "y": 390,
            "width": 520,
            "height": 150,
            "fill": "#ffffff",
            "opacity": 0.78
          },
          {
            "action": "add_text_layer",
            "id": "postcard_title",
            "label": "Postcard Title",
            "text": "COASTAL RETREAT",
            "x": 62,
            "y": 412,
            "font_size": 42,
            "color": "#1b3a4b"
          },
          {
            "action": "add_text_layer",
            "id": "postcard_detail",
            "label": "Postcard Detail",
            "text": "MAY WEEKEND GUIDE",
            "x": 66,
            "y": 482,
            "font_size": 26,
            "color": "#2f6f73"
          }
        ]
      }
    }
  ],
