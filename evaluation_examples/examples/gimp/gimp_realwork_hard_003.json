{
  "id": "gimp_realwork_hard_003",
  "software": "gimp",
  "difficulty": "complex",
  "description": "Create a customer-review card from a real storefront photo.",
  "instruction": "Make an 800x600 review card from the coffee street photo. Crop the sidewalk and storefront, desaturate it, add a warm coral quote panel on the right, add the title FIVE STAR LOCAL PICK, and add the detail BEST MORNING STOP.",
  "source": "asil_realwork_hard_v1",
  "snapshot": "gimp_default",
  "config": [],
  "related_apps": [
    "gimp"
  ],
  "actions": [
    {
      "action_type": "invoke_function",
      "target": "gimp",
      "params": {
        "operations": [
          {
            "action": "add_image_layer",
            "id": "review_photo",
            "label": "Review Photo",
            "asset_path": "evaluation_examples/assets/realwork_images/coffee_street_960.jpg",
            "x": 0,
            "y": 0,
            "width": 800,
            "height": 600,
            "crop": {
              "x": 110,
              "y": 40,
              "width": 760,
              "height": 570
            },
            "filters": {
              "contrast": 1.05,
              "saturation": 0.2,
              "brightness": 0.98
            }
          },
          {
            "action": "add_layer",
            "id": "quote_panel",
            "label": "Quote Panel",
            "kind": "rectangle",
            "x": 470,
            "y": 0,
            "width": 330,
            "height": 600,
            "fill": "#d65a31",
            "opacity": 0.86
          },
          {
            "action": "add_text_layer",
            "id": "review_title",
            "label": "Review Title",
            "text": "FIVE STAR LOCAL PICK",
            "x": 500,
            "y": 150,
            "font_size": 30,
            "color": "#ffffff"
          },
          {
            "action": "add_text_layer",
            "id": "review_detail",
            "label": "Review Detail",
            "text": "BEST MORNING STOP",
            "x": 502,
            "y": 250,
            "font_size": 26,
            "color": "#ffe8d6"
          }
        ]
      }
    }
  ],
