{
  "id": "gimp_realwork_hard_006",
  "software": "gimp",
  "difficulty": "complex",
  "description": "Create a report cover header from a real coastal photo.",
  "instruction": "Create an 800x600 report cover from the coast photo. Place the photo as a 800x360 header crop, add a dark blue title strip below it, add the title FIELD REPORT, and add the detail COASTAL EROSION SNAPSHOT.",
  "source": "asil_realwork_hard_v1",
  "snapshot": "gimp_default",
  "config": [],
  "related_apps": [
    "gimp"
  ],
  "actions": [
    {
      "action_type": "invoke_function",
      "target": "gimp",
      "params": {
        "operations": [
          {
            "action": "add_image_layer",
            "id": "report_header_photo",
            "label": "Report Header Photo",
            "asset_path": "evaluation_examples/assets/realwork_images/coast_960.jpg",
            "x": 0,
            "y": 0,
            "width": 800,
            "height": 600,
            "crop": {
              "x": 0,
              "y": 90,
              "width": 960,
              "height": 432
            },
            "filters": {
              "brightness": 0.96,
              "contrast": 1.16,
              "saturation": 0.9
            }
          },
          {
            "action": "add_layer",
            "id": "report_strip",
            "label": "Report Strip",
            "kind": "rectangle",
            "x": 0,
            "y": 360,
            "width": 800,
            "height": 160,
            "fill": "#0b2545",
            "opacity": 0.9
          },
          {
            "action": "add_text_layer",
            "id": "report_title",
            "label": "Report Title",
            "text": "FIELD REPORT",
            "x": 42,
            "y": 388,
            "font_size": 46,
            "color": "#ffffff"
          },
          {
            "action": "add_text_layer",
            "id": "report_detail",
            "label": "Report Detail",
            "text": "COASTAL EROSION SNAPSHOT",
            "x": 46,
            "y": 462,
            "font_size": 26,
            "color": "#bee3f8"
          }
        ]
      }
    }
  ],
