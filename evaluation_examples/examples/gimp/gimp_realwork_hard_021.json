{
  "id": "gimp_realwork_hard_021",
  "software": "gimp",
  "difficulty": "complex",
  "description": "Create a real-photo operations handoff cover from the office desk image.",
  "instruction": "Create an 800x600 operations handoff cover from the real office desk photo. Complete it as a production workflow: place and crop the photo, apply the final color treatment, add the main information panel, add the accent strip, add the approval badge, add the headline 'TEAM HANDOFF 021', add the detail 'NEXT STEPS SET 021', add the owner/status line 'OWNER: OPS LEAD', and add the CTA 'SEND UPDATE'.",
  "source": "asil_realwork_hard_v2",
  "snapshot": "gimp_default",
  "config": [],
  "related_apps": [
    "gimp"
  ],
  "actions": [
    {
      "action_type": "invoke_function",
      "target": "gimp",
      "params": {
        "operations": [
          {
            "action": "add_image_layer",
            "id": "hard_photo_021",
            "label": "Hard Photo 021",
            "asset_path": "evaluation_examples/assets/realwork_images/office_desk_960.jpg",
            "x": 0,
            "y": 0,
            "width": 800,
            "height": 600,
            "crop": {
              "x": 22,
              "y": 36,
              "width": 460,
              "height": 620
            },
            "filters": {
              "brightness": 1.05,
              "contrast": 1.06,
              "saturation": 0.92
            }
          }
        ]
      }
    },
    {
      "action_type": "invoke_function",
      "target": "gimp",
      "params": {
        "operations": [
          {
            "action": "apply_filter",
            "id": "hard_photo_021",
            "filters": {
              "brightness": 0.97,
              "contrast": 1.13,
              "saturation": 1.0,
              "sharpen": true
            }
          }
        ]
      }
    },
    {
      "action_type": "invoke_function",
      "target": "gimp",
      "params": {
        "operations": [
