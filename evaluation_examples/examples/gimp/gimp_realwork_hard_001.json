{
  "id": "gimp_realwork_hard_001",
  "software": "gimp",
  "difficulty": "complex",
  "description": "Create a real-photo open-house social banner for a cafe storefront.",
  "instruction": "Create an 800x600 cafe open-house banner from the real coffee street photo. Crop the photo to the storefront area, reduce saturation, increase contrast, add a dark navy bottom information band, add the title OPEN HOUSE, and add the detail SATURDAY 10 AM - 2 PM.",
  "source": "asil_realwork_hard_v1",
  "snapshot": "gimp_default",
  "config": [],
  "related_apps": [
    "gimp"
  ],
  "actions": [
    {
      "action_type": "invoke_function",
      "target": "gimp",
      "params": {
        "operations": [
          {
            "action": "add_image_layer",
            "id": "street_photo",
            "label": "Street Photo",
            "asset_path": "evaluation_examples/assets/realwork_images/coffee_street_960.jpg",
            "x": 0,
            "y": 0,
            "width": 800,
            "height": 600,
            "crop": {
              "x": 40,
              "y": 20,
              "width": 860,
              "height": 650
            },
            "filters": {
              "contrast": 1.18,
              "saturation": 0.82,
              "brightness": 0.95
            }
          },
          {
            "action": "add_layer",
            "id": "info_band",
            "label": "Info Band",
            "kind": "rectangle",
            "x": 0,
            "y": 420,
            "width": 800,
            "height": 180,
            "fill": "#102a43",
            "opacity": 0.82
          },
          {
            "action": "add_text_layer",
            "id": "banner_title",
            "label": "Banner Title",
            "text": "OPEN HOUSE",
            "x": 44,
            "y": 446,
            "font_size": 48,
            "color": "#ffffff"
          },
          {
            "action": "add_text_layer",
            "id": "banner_detail",
            "label": "Banner Detail",
            "text": "SATURDAY 10 AM - 2 PM",
            "x": 48,
            "y": 520,
            "font_size": 28,
            "color": "#f6d365"
          }
        ]
      }
    }
  ],
