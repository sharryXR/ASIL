{
  "id": "libreoffice_17",
  "instruction": "Create a company P&L statement. Set cell A1 to 'P&L Statement 2025'. Put headers Item, Amount, % of Revenue, YoY Change in row 2. Then add exactly these 14 line items in order in column A: Revenue, COGS, Gross Profit, R&D, Sales & Marketing, G&A, Total OpEx, EBITDA, Depreciation, EBIT, Interest Expense, EBT, Tax (25%), Net Income. Use any reasonable numeric values for the other columns.",
  "source": "asil_benchmark_v1",
  "snapshot": "libreoffice_calc_default",
  "config": [],
  "related_apps": [
    "libreoffice"
  ],
  "evaluator": {
    "selection": "best_score",
    "paths": [
      {
        "path_id": "libreoffice_17_primary_path",
        "exclusive_group": "success_paths",
        "checkpoints": [
          {
            "id": "libreoffice_17_title",
            "weight": 0.2,
            "gui_visible_required": true,
            "rule": {
              "element_value": {
                "id": "Sheet1!A1",
                "key": null,
                "expected": "P&L Statement 2025"
              }
            }
          },
          {
            "id": "libreoffice_17_headers",
            "weight": 0.2,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_headers": {
                "sheet": "Sheet1",
                "row": 2,
                "expected": [
                  "Item",
                  "Amount",
                  "% of Revenue",
                  "YoY Change"
                ]
              }
            }
          },
          {
            "id": "libreoffice_17_line_items",
            "weight": 0.2,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_column_sequence": {
                "sheet": "Sheet1",
                "column": "A",
                "start_row": 3,
                "expected": [
                  "Revenue",
                  "COGS",
                  "Gross Profit",
                  "R&D",
                  "Sales & Marketing",
                  "G&A",
                  "Total OpEx",
                  "EBITDA",
                  "Depreciation",
                  "EBIT",
                  "Interest Expense",
                  "EBT",
                  "Tax (25%)",
                  "Net Income"
                ]
              }
            }
          },
          {
            "id": "libreoffice_17_rows",
            "weight": 0.2,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_complete_rows": {
                "sheet": "Sheet1",
                "columns": [
                  "A",
                  "B",
                  "C",
                  "D"
                ],
                "start_row": 3,
                "expected_rows": 14
              }
            }
          },
          {
            "id": "libreoffice_17_numeric_cols",
            "weight": 0.2,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_column_type": {
                "sheet": "Sheet1",
                "columns": [
                  "B",
                  "C",
                  "D"
                ],
                "start_row": 3,
                "end_row": 16,
                "expected": "number"
              }
            }
          }
        ]
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low",
