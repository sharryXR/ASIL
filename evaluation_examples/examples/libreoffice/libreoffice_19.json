{
  "id": "libreoffice_19",
  "instruction": "Create a payroll sheet with columns (ID, Name, Department, Base Salary, Position Allowance, Performance Bonus, Insurance, Tax, Net Pay). Use any realistic sample data for exactly 10 complete employee rows. Keep IDs non-empty and unique. Use non-negative numeric values in the salary-related columns. Net Pay should equal Base Salary + Position Allowance + Performance Bonus - Insurance - Tax for each row.",
  "source": "asil_benchmark_v1",
  "snapshot": "libreoffice_calc_default",
  "config": [],
  "related_apps": [
    "libreoffice"
  ],
  "evaluator": {
    "selection": "best_score",
    "paths": [
      {
        "path_id": "libreoffice_19_primary_path",
        "exclusive_group": "success_paths",
        "checkpoints": [
          {
            "id": "libreoffice_19_headers",
            "weight": 0.166667,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_headers": {
                "sheet": "Sheet1",
                "row": 1,
                "expected": [
                  "ID",
                  "Name",
                  "Department",
                  "Base Salary",
                  "Position Allowance",
                  "Performance Bonus",
                  "Insurance",
                  "Tax",
                  "Net Pay"
                ]
              }
            }
          },
          {
            "id": "libreoffice_19_rows",
            "weight": 0.166667,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_complete_rows": {
                "sheet": "Sheet1",
                "columns": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E",
                  "F",
                  "G",
                  "H",
                  "I"
                ],
                "start_row": 2,
                "expected_rows": 10
              }
            }
          },
          {
            "id": "libreoffice_19_unique_ids",
            "weight": 0.166667,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_column_unique": {
                "sheet": "Sheet1",
                "column": "A",
                "start_row": 2,
                "end_row": 11
              }
            }
          },
          {
            "id": "libreoffice_19_text_cols",
            "weight": 0.166667,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_column_type": {
                "sheet": "Sheet1",
                "columns": [
                  "B",
                  "C"
                ],
                "start_row": 2,
                "end_row": 11,
                "expected": "text"
              }
            }
          },
          {
            "id": "libreoffice_19_numeric_cols",
            "weight": 0.166667,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_column_type": {
                "sheet": "Sheet1",
                "columns": [
                  "D",
                  "E",
                  "F",
                  "G",
                  "H",
                  "I"
                ],
                "start_row": 2,
                "end_row": 11,
                "expected": "number",
                "min": 0
              }
            }
          },
          {
            "id": "libreoffice_19_net_pay_relation",
            "weight": 0.166665,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_row_numeric_relation": {
                "sheet": "Sheet1",
                "start_row": 2,
                "end_row": 11,
                "target_column": "I",
                "add_columns": [
                  "D",
                  "E",
                  "F"
                ],
                "subtract_columns": [
                  "G",
                  "H"
                ]
              }
            }
          }
        ]
      }
    ]
  },
  "proxy": false,
