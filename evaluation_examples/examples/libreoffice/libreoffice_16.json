            "weight": 0.2,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_column_unique": {
                "sheet": "Sheet1",
                "column": "A",
                "start_row": 2,
                "end_row": 7
              }
            }
          },
          {
            "id": "libreoffice_16_name_text",
            "weight": 0.2,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_column_type": {
                "sheet": "Sheet1",
                "column": "A",
                "start_row": 2,
                "end_row": 7,
                "expected": "text"
              }
            }
          },
          {
            "id": "libreoffice_16_scores",
            "weight": 0.2,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_column_type": {
                "sheet": "Sheet1",
                "columns": [
                  "B",
                  "C",
                  "D",
                  "E",
                  "F"
                ],
                "start_row": 2,
                "end_row": 7,
                "expected": "number",
                "min": 0,
                "max": 100
              }
            }
          }
        ]
      }
    ]
  },
