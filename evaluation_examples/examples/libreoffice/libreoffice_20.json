{
  "id": "libreoffice_20",
  "instruction": "Create a yearly sales analysis with columns (Month, Electronics, Clothing, Food, Furniture, Sports). Add exactly 12 rows for Jan, Feb, Mar, Apr, May, Jun, Jul, Aug, Sep, Oct, Nov, Dec in that order, and use any reasonable non-negative numeric sales values in the category columns.",
  "source": "asil_benchmark_v1",
  "snapshot": "libreoffice_calc_default",
  "config": [],
  "related_apps": [
    "libreoffice"
  ],
  "evaluator": {
    "selection": "best_score",
    "paths": [
      {
        "path_id": "libreoffice_20_primary_path",
        "exclusive_group": "success_paths",
        "checkpoints": [
          {
            "id": "libreoffice_20_headers",
            "weight": 0.25,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_headers": {
                "sheet": "Sheet1",
                "row": 1,
                "expected": [
                  "Month",
                  "Electronics",
                  "Clothing",
                  "Food",
                  "Furniture",
                  "Sports"
                ]
              }
            }
          },
          {
            "id": "libreoffice_20_rows",
            "weight": 0.25,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_complete_rows": {
                "sheet": "Sheet1",
                "columns": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E",
                  "F"
                ],
                "start_row": 2,
                "expected_rows": 12
              }
            }
          },
          {
            "id": "libreoffice_20_months",
            "weight": 0.25,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_column_sequence": {
                "sheet": "Sheet1",
                "column": "A",
                "start_row": 2,
                "expected": [
                  "Jan",
                  "Feb",
                  "Mar",
                  "Apr",
                  "May",
                  "Jun",
                  "Jul",
                  "Aug",
                  "Sep",
                  "Oct",
                  "Nov",
                  "Dec"
                ]
              }
            }
          },
          {
            "id": "libreoffice_20_numeric_cols",
            "weight": 0.25,
            "gui_visible_required": true,
            "rule": {
              "spreadsheet_column_type": {
                "sheet": "Sheet1",
                "columns": [
                  "B",
                  "C",
                  "D",
                  "E",
                  "F"
                ],
                "start_row": 2,
                "end_row": 13,
                "expected": "number",
                "min": 0
              }
            }
          }
        ]
      }
    ]
  },
  "proxy": false,
  "fixed_ip": false,
  "possibility_of_env_change": "low",
