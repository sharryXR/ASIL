{
  "software": "obs",
  "tasks": [
    {
      "id": "obs_01",
      "software": "obs",
      "difficulty": "simple",
      "description": "Switch to scene named 'Main Scene'",
      "actions": [
        {
          "action_type": "api_call",
          "target": "obs-websocket",
          "params": {
            "method": "SetCurrentProgramScene",
            "args": {"sceneName": "Main Scene"}
          }
        }
      ],
      "validation": {"current_scene": "Main Scene"}
    },
    {
      "id": "obs_02",
      "software": "obs",
      "difficulty": "simple",
      "description": "Toggle visibility of source 'Webcam' in current scene",
      "actions": [
        {
          "action_type": "api_call",
          "target": "obs-websocket",
          "params": {
            "method": "SetSceneItemEnabled",
            "args": {"sceneName": "Main Scene", "sceneItemId": 1, "sceneItemEnabled": false}
          }
        }
      ],
      "validation": {"source_visible": {"scene": "Main Scene", "source": "Webcam", "expected": false}}
    },
    {
      "id": "obs_03",
      "software": "obs",
      "difficulty": "simple",
      "description": "Get the current program scene name",
      "actions": [
        {
          "action_type": "api_call",
          "target": "obs-websocket",
          "params": {
            "method": "GetCurrentProgramScene",
            "args": {}
          }
        }
      ],
      "validation": {"response_has_field": "currentProgramSceneName"}
    },
    {
