          },
          {
            "element_value": {
              "id": "label:1",
              "key": "color",
              "expected": "#ee0701"
            }
          }
        ]
      }
    },
    {
      "id": "gitea_08",
      "software": "gitea",
      "difficulty": "medium",
      "description": "Create a milestone named 'v1.0' with due date 2026-06-30",
      "actions": [
        {
          "action_type": "api_call",
          "target": "gitea_rest",
          "params": {
            "method": "POST",
            "endpoint": "/api/v1/repos/{{owner}}/{{repo}}/milestones",
            "body": {
              "title": "v1.0",
              "description": "Initial release milestone",
              "due_on": "2026-06-30T00:00:00Z"
            }
          }
        }
      ],
      "validation": {
        "conditions": [
          {
            "any_element_value": {
              "type": "milestone",
              "key": "title",
              "expected": "v1.0"
            }
          }
        ]
      }
    },
    {
      "id": "gitea_09",
      "software": "gitea",
      "difficulty": "complex",
      "description": "Update repository settings: disable wiki, enable issues, set description to 'Updated project description'",
      "actions": [
        {
          "action_type": "api_call",
          "target": "gitea_rest",
          "params": {
            "method": "PATCH",
            "endpoint": "/api/v1/repos/{{owner}}/{{repo}}",
            "body": {
              "description": "Updated project description",
              "has_issues": true,
              "has_wiki": false,
              "has_projects": true
            }
          }
        }
      ],
      "validation": {
        "conditions": [
          {
            "element_value": {
              "id": "repo:asil_admin/test-repo",
              "key": "has_wiki",
              "expected": false
            }
          },
          {
            "element_value": {
              "id": "repo:asil_admin/test-repo",
              "key": "has_issues",
              "expected": true
            }
          },
          {
            "element_contains": {
              "id": "repo:asil_admin/test-repo",
              "key": "description",
              "expected": "Updated project description"
            }
          }
        ]
      }
    },
    {
      "id": "gitea_10",
      "software": "gitea",
      "difficulty": "complex",
      "description": "Create milestone 'v2.0', create two issues linked to it ('Add dark mode' and 'Fix pagination bug'), verify milestone has open issues",
      "actions": [
        {
          "action_type": "api_call",
          "target": "gitea_rest",
          "params": {
            "method": "POST",
            "endpoint": "/api/v1/repos/{{owner}}/{{repo}}/milestones",
            "body": {
              "title": "v2.0",
              "description": "Second release milestone"
            }
          }
        },
        {
          "action_type": "api_call",
          "target": "gitea_rest",
          "params": {
            "method": "POST",
            "endpoint": "/api/v1/repos/{{owner}}/{{repo}}/issues",
            "body": {
              "title": "Add dark mode",
              "body": "Implement dark mode toggle in settings.",
              "milestone": 1
            }
          }
        },
        {
          "action_type": "api_call",
          "target": "gitea_rest",
          "params": {
            "method": "POST",
            "endpoint": "/api/v1/repos/{{owner}}/{{repo}}/issues",
            "body": {
              "title": "Fix pagination bug",
              "body": "Page 2 returns duplicate results.",
              "milestone": 1
            }
          }
        }
      ],
      "validation": {
        "conditions": [
          {
            "any_element_value": {
              "type": "milestone",
              "key": "title",
              "expected": "v2.0"
            }
          },
          {
            "element_contains": {
              "id": "issue:1",
              "key": "title",
              "expected": "Add dark mode"
            }
          },
          {
            "element_contains": {
              "id": "issue:2",
              "key": "title",
              "expected": "Fix pagination bug"
            }
          }
        ]
      }
    },
