{
  "software": "gitea",
  "tasks": [
    {
      "id": "gitea_01",
      "software": "gitea",
      "difficulty": "simple",
      "description": "Create a new public repository named 'test-repo'",
      "actions": [
        {
          "action_type": "api_call",
          "target": "gitea_rest",
          "params": {
            "method": "POST",
            "endpoint": "/api/v1/user/repos",
            "body": {
              "name": "test-repo",
              "description": "A test repository",
              "private": false,
              "auto_init": true,
              "default_branch": "main"
            }
          }
        }
      ],
      "validation": {
        "element_exists": "repo:asil_admin/test-repo"
      }
    },
    {
      "id": "gitea_02",
      "software": "gitea",
      "difficulty": "simple",
      "description": "Create an issue titled 'Bug: login fails on mobile'",
      "actions": [
        {
          "action_type": "api_call",
          "target": "gitea_rest",
          "params": {
            "method": "POST",
            "endpoint": "/api/v1/repos/{{owner}}/{{repo}}/issues",
            "body": {
              "title": "Bug: login fails on mobile",
              "body": "Users report that logging in via mobile browser results in a 500 error.",
              "type": "issue"
            }
          }
        }
      ],
      "validation": {
        "conditions": [
          {
            "element_contains": {
              "id": "issue:1",
              "key": "title",
              "expected": "Bug: login fails on mobile"
            }
          }
        ]
      }
    },
    {
      "id": "gitea_03",
      "software": "gitea",
      "difficulty": "simple",
      "description": "List all repositories for the authenticated user",
      "actions": [
        {
          "action_type": "api_call",
          "target": "gitea_rest",
          "params": {
            "method": "GET",
            "endpoint": "/api/v1/repos/search?limit=50",
            "body": {}
          }
        }
      ],
      "validation": {
        "count_at_least": 1
      }
    },
    {
      "id": "gitea_04",
      "software": "gitea",
      "difficulty": "simple",
      "description": "Delete the repository 'old-project'",
      "actions": [
        {
          "action_type": "api_call",
          "target": "gitea_rest",
          "params": {
            "method": "DELETE",
            "endpoint": "/api/v1/repos/{{owner}}/old-project",
            "body": {}
          }
        }
      ],
      "validation": {
        "element_not_exists": "repo:asil_admin/old-project"
      }
    },
    {
      "id": "gitea_05",
      "software": "gitea",
      "difficulty": "simple",
      "description": "Close issue #1",
      "actions": [
        {
          "action_type": "api_call",
          "target": "gitea_rest",
          "params": {
            "method": "PATCH",
            "endpoint": "/api/v1/repos/{{owner}}/{{repo}}/issues/1",
            "body": {
              "state": "closed"
            }
          }
        }
      ],
      "validation": {
        "element_value": {
          "id": "issue:1",
          "key": "state",
          "expected": "closed"
        }
      },
      "initial_state": "with_issues"
    },
    {
      "id": "gitea_06",
      "software": "gitea",
      "difficulty": "medium",
      "description": "Create a pull request from 'feature/login-fix' to 'main'",
      "actions": [
        {
          "action_type": "api_call",
          "target": "gitea_rest",
          "params": {
            "method": "POST",
            "endpoint": "/api/v1/repos/{{owner}}/{{repo}}/pulls",
            "body": {
              "title": "Fix login on mobile",
              "body": "This PR resolves the mobile login bug reported in issue #1.",
              "head": "feature/login-fix",
              "base": "main"
            }
          }
        }
      ],
      "validation": {
        "conditions": [
          {
            "element_contains": {
              "id": "pr:1",
              "key": "head",
              "expected": "feature/login-fix"
            }
          }
        ]
      }
    },
    {
      "id": "gitea_07",
      "software": "gitea",
      "difficulty": "medium",
      "description": "Create a label 'bug' with red color #ee0701",
      "actions": [
        {
          "action_type": "api_call",
          "target": "gitea_rest",
          "params": {
            "method": "POST",
            "endpoint": "/api/v1/repos/{{owner}}/{{repo}}/labels",
            "body": {
              "name": "bug",
              "color": "#ee0701",
              "description": "Something is not working"
