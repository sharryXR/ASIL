            "script": [
              "import bpy",
              "bpy.ops.object.light_add(type='SPOT', location=(0, 0, 5))"
            ]
          }
        }
      ],
      "validation": {"object_type_exists": "LIGHT"}
    },
    {
      "id": "blender_17",
      "software": "blender",
      "difficulty": "complex",
      "description": "Create a monkey head (Suzanne) with a green material and subdivision modifier",
      "actions": [
        {
          "action_type": "invoke_function",
          "target": "bpy",
          "params": {
            "script": [
              "import bpy",
              "bpy.ops.mesh.primitive_monkey_add(location=(0, 0, 0))",
              "bpy.ops.object.modifier_add(type='SUBSURF')",
              "mat = bpy.data.materials.new(name='GreenMaterial')",
              "mat.use_nodes = True",
              "bsdf = mat.node_tree.nodes['Principled BSDF']",
              "bsdf.inputs['Base Color'].default_value = (0.0, 1.0, 0.0, 1.0)",
              "bpy.context.object.data.materials.append(mat)"
            ]
          }
        }
      ],
      "validation": {"material_exists": "GreenMaterial"}
    },
    {
      "id": "blender_18",
      "software": "blender",
      "difficulty": "complex",
      "description": "Build a simple room: floor plane, 4 wall planes, and a camera",
      "actions": [
        {
          "action_type": "invoke_function",
          "target": "bpy",
          "params": {
            "script": [
              "import bpy",
              "bpy.ops.mesh.primitive_plane_add(size=10, location=(0, 0, 0))",
              "bpy.ops.mesh.primitive_plane_add(size=10, location=(0, -5, 5))",
              "bpy.context.object.rotation_euler = (1.5708, 0, 0)",
              "bpy.ops.mesh.primitive_plane_add(size=10, location=(0, 5, 5))",
              "bpy.context.object.rotation_euler = (1.5708, 0, 0)",
              "bpy.ops.mesh.primitive_plane_add(size=10, location=(-5, 0, 5))",
              "bpy.context.object.rotation_euler = (0, 1.5708, 0)",
              "bpy.ops.mesh.primitive_plane_add(size=10, location=(5, 0, 5))",
              "bpy.context.object.rotation_euler = (0, 1.5708, 0)",
              "bpy.ops.object.camera_add(location=(0, -8, 3))"
            ]
          }
        }
      ],
      "validation": {"object_type_exists": "CAMERA"}
    },
    {
      "id": "blender_19",
      "software": "blender",
      "difficulty": "complex",
      "description": "Create two cubes with different materials and animate the first one",
      "actions": [
        {
          "action_type": "invoke_function",
          "target": "bpy",
          "params": {
            "script": [
              "import bpy",
              "bpy.ops.mesh.primitive_cube_add(location=(0, 0, 0))",
              "cube1 = bpy.context.object",
              "mat1 = bpy.data.materials.new(name='Mat_Red')",
              "cube1.data.materials.append(mat1)",
              "cube1.keyframe_insert(data_path='location', frame=1)",
              "cube1.location = (3, 0, 0)",
              "cube1.keyframe_insert(data_path='location', frame=20)",
              "bpy.ops.mesh.primitive_cube_add(location=(5, 0, 0))",
              "cube2 = bpy.context.object",
              "mat2 = bpy.data.materials.new(name='Mat_Blue')",
              "cube2.data.materials.append(mat2)"
            ]
          }
        }
      ],
      "validation": {"material_exists": "Mat_Red"}
    },
    {
      "id": "blender_20",
      "software": "blender",
      "difficulty": "complex",
      "description": "Create a product visualization scene: object, 3-point lighting, camera, and EEVEE render at 4K",
      "actions": [
        {
          "action_type": "invoke_function",
          "target": "bpy",
          "params": {
            "script": [
              "import bpy",
              "bpy.ops.mesh.primitive_uv_sphere_add(location=(0, 0, 0))",
              "bpy.ops.object.light_add(type='AREA', location=(3, -3, 5))",
              "bpy.ops.object.light_add(type='AREA', location=(-3, -3, 5))",
              "bpy.ops.object.light_add(type='AREA', location=(0, 5, 3))",
              "bpy.ops.object.camera_add(location=(0, -6, 2))",
              "bpy.context.scene.render.engine = 'BLENDER_EEVEE'",
              "bpy.context.scene.render.resolution_x = 3840",
              "bpy.context.scene.render.resolution_y = 2160"
            ]
          }
        }
      ],
      "validation": {"render_setting": {"key": "resolution_x", "expected": 3840}}
    }
  ]
}
