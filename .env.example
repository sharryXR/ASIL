# === LLM provider API keys; never commit real values ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_BASE=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4

# === Sandbox / Docker ===
ASIL_SANDBOX=false
GITEA_URL=http://localhost:3000
GITEA_PASSWORD=asil_password
GITEA_TOKEN_FILE=
OBS_WS_HOST=localhost
OBS_WS_PORT=4455
OBS_WS_PASSWORD=

# === Clean-device Docker bootstrap (non-secret defaults) ===
ASIL_BOOTSTRAP_PROJECT_NAME=asil-bootstrap
ASIL_BOOTSTRAP_REPORT_PATH=results/setup/docker_bootstrap_report.json
ASIL_BOOTSTRAP_NETWORK_TIMEOUT_S=20
PLAYWRIGHT_DOWNLOAD_CONNECTION_TIMEOUT=120000
PLAYWRIGHT_DOWNLOAD_TOTAL_TIMEOUT=180s
PLAYWRIGHT_FALLBACK_HOST=https://npmmirror.com/mirrors/chrome-for-testing
